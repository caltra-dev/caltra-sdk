{
  "name": "@caltra/react",
  "version": "0.9.0",
  "description": "Styled React chat and assistant-ui runtime adapter for Caltra sessions",
  "type": "module",
  "sideEffects": [
    "./dist/ui/index.js",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caltra-dev/caltra-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/caltra-dev/caltra-sdk#readme",
  "bugs": {
    "url": "https://github.com/caltra-dev/caltra-sdk/issues"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./styles.css": "./dist/ui/styles.css",
    "./scrollbar.css": "./dist/scrollbar.css",
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/ui/styles.css dist/ui/styles.css && cp src/scrollbar.css dist/scrollbar.css && cp src/ui/assistant-ui/LICENSE dist/ui/assistant-ui/LICENSE",
    "prebuild": "npm run build --workspace=@caltra/client",
    "pretest": "npm run build --workspace=@caltra/client",
    "pretypecheck": "npm run build --workspace=@caltra/client",
    "test": "vitest run tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@assistant-ui/react-markdown": "0.14.12",
    "@base-ui/react": "1.9.0",
    "@caltra/client": "0.8.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "@assistant-ui/react": "^0.15.16",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.16",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
