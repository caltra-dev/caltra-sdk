{
  "name": "@caltra/server",
  "version": "0.2.0",
  "description": "Server-side SDK for the Caltra Server API",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caltra-dev/caltra-sdk.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/caltra-dev/caltra-sdk#readme",
  "bugs": {
    "url": "https://github.com/caltra-dev/caltra-sdk/issues"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
