{
  "name": "@caltra/test-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace=@caltra/react",
    "predev": "npm run build --workspace=@caltra/react",
    "pretest": "npm run build --workspace=@caltra/react",
    "pretypecheck": "npm run build --workspace=@caltra/react",
    "build": "vite build",
    "dev": "vite --host 0.0.0.0",
